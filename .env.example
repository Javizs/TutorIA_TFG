# MongoDB connection string. Use a local database or a restricted Atlas user.
MONGODB_URI=

# Secret used by NextAuth to sign JWT/session data.
NEXTAUTH_SECRET=

# Public base URL of the application, for example http://localhost:3000 locally.
NEXTAUTH_URL=

# OpenAI API key used by tutor chat, feedback, speech and transcription routes.
OPENAI_API_KEY=
